doctype html
html(lang="en")
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1")
    meta(name="theme-color" content="#11243d")
    title #{user.name} | Express Homework 04
    link(rel="icon" type="image/svg+xml" href="/assets/favicon.svg")
    link(rel="icon" href="/favicon.ico")
    link(rel="stylesheet" href="/assets/css/styles.css")
  body
    .site-shell
      header.site-header
        .container.header-inner
          a.brand(href="/users" aria-label="Express Studio home")
            span.brand-mark(aria-hidden="true") E4
            span.brand-copy
              strong Express Studio
              small EXPRESS / HOMEWORK 04 / STATIC + COOKIES + JWT
          nav.site-nav(aria-label="Main navigation")
            a.nav-link(href="/users" aria-current="page") Users
            a.nav-link(href="/articles") Articles
      main.container.page-content
        a.back-link(href="/users") ← Back to users
        section.detail-panel(aria-labelledby="page-title")
          p.eyebrow PUG · USER PROFILE
          h1#page-title= user.name
          p.lead This user profile is generated by Express using a PUG template.
          dl.metadata
            .meta-row
              dt User ID
              dd= user.id
            .meta-row
              dt Name
              dd= user.name
          a.text-link(href="/users") Browse all users →
      footer.site-footer
        .container.footer-inner
          span Copyright © 2026 Andrii Dolzhenko.
